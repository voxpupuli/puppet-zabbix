<%- | String[1]         $zabbix_url,
      Variant[
        String[1],
        Struct[{
          zabbix_user => String[1],
          zabbix_pass => String[1],
        }]
      ] $zabbix_auth,
      Boolean           $apache_use_ssl,
      Optional[Boolean] $ignore_version,
| -%>
# MANAGED BY PUPPET
[default]
zabbix_url     = <%= $zabbix_url %>
<% if $zabbix_auth =~ String { -%>
zabbix_token   = <%= $zabbix_auth %>
<% } elsif $zabbix_auth =~ Hash { -%>
zabbix_user    = <%= $zabbix_auth['zabbix_user'] %>
zabbix_pass    = <%= $zabbix_auth['zabbix_pass'] %>
<% } -%>
apache_use_ssl = <%= $apache_use_ssl %>
<% if $ignore_version { -%>
ignore_version = <%= $ignore_version %>
<% } -%>
